constraint activity_feed.activity_feed_pkey PRIMARY KEY (id)
constraint activity_feed.activity_feed_user_id_fkey FOREIGN KEY (user_id) REFERENCES profiles(id) ON DELETE CASCADE
constraint audit_logs.audit_logs_pkey PRIMARY KEY (id)
constraint audit_logs.audit_logs_user_id_fkey FOREIGN KEY (user_id) REFERENCES profiles(id) ON DELETE SET NULL
constraint budget_items.budget_items_created_by_fkey FOREIGN KEY (created_by) REFERENCES profiles(id)
constraint budget_items.budget_items_job_id_fkey FOREIGN KEY (job_id) REFERENCES jobs(id) ON DELETE SET NULL
constraint budget_items.budget_items_pkey PRIMARY KEY (id)
constraint budget_items.budget_items_project_id_fkey FOREIGN KEY (project_id) REFERENCES projects(id) ON DELETE CASCADE
constraint call_sheet_calls.call_sheet_calls_call_sheet_id_fkey FOREIGN KEY (call_sheet_id) REFERENCES call_sheets(id) ON DELETE CASCADE
constraint call_sheet_calls.call_sheet_calls_crew_user_id_fkey FOREIGN KEY (crew_user_id) REFERENCES profiles(id) ON DELETE CASCADE
constraint call_sheet_calls.call_sheet_calls_pkey PRIMARY KEY (id)
constraint call_sheets.call_sheets_pkey PRIMARY KEY (id)
constraint call_sheets.call_sheets_project_id_fkey FOREIGN KEY (project_id) REFERENCES projects(id) ON DELETE CASCADE
constraint call_sheets.call_sheets_project_id_shoot_day_key UNIQUE (project_id, shoot_day)
constraint call_sheets.call_sheets_updated_by_fkey FOREIGN KEY (updated_by) REFERENCES profiles(id)
constraint campaigns.campaigns_created_by_fkey FOREIGN KEY (created_by) REFERENCES profiles(id)
constraint campaigns.campaigns_pkey PRIMARY KEY (id)
constraint campaigns.campaigns_project_id_fkey FOREIGN KEY (project_id) REFERENCES projects(id) ON DELETE CASCADE
constraint channel_members.channel_members_channel_id_fkey FOREIGN KEY (channel_id) REFERENCES channels(id) ON DELETE CASCADE
constraint channel_members.channel_members_channel_id_user_id_key UNIQUE (channel_id, user_id)
constraint channel_members.channel_members_pkey PRIMARY KEY (id)
constraint channel_members.channel_members_user_id_fkey FOREIGN KEY (user_id) REFERENCES profiles(id) ON DELETE CASCADE
constraint channels.channels_created_by_fkey FOREIGN KEY (created_by) REFERENCES profiles(id)
constraint channels.channels_pkey PRIMARY KEY (id)
constraint channels.channels_post_policy_check CHECK ((post_policy = ANY (ARRAY['viewers'::text, 'members'::text, 'managers'::text])))
constraint channels.channels_project_id_fkey FOREIGN KEY (project_id) REFERENCES projects(id) ON DELETE CASCADE
constraint channels.channels_type_check CHECK ((type = ANY (ARRAY['text'::text, 'voice'::text])))
constraint character_castings.character_castings_created_by_fkey FOREIGN KEY (created_by) REFERENCES profiles(id)
constraint character_castings.character_castings_crew_user_id_fkey FOREIGN KEY (crew_user_id) REFERENCES profiles(id) ON DELETE CASCADE
constraint character_castings.character_castings_pkey PRIMARY KEY (id)
constraint character_castings.character_castings_project_id_character_name_key UNIQUE (project_id, character_name)
constraint character_castings.character_castings_project_id_fkey FOREIGN KEY (project_id) REFERENCES projects(id) ON DELETE CASCADE
constraint character_media.character_media_character_fkey FOREIGN KEY (character_id) REFERENCES script_characters(id) ON DELETE CASCADE
constraint character_media.character_media_created_by_fkey FOREIGN KEY (created_by) REFERENCES profiles(id) ON DELETE SET NULL
constraint character_media.character_media_media_fkey FOREIGN KEY (media_id, project_id) REFERENCES media(id, project_id) ON DELETE CASCADE
constraint character_media.character_media_pkey PRIMARY KEY (character_id, media_id)
constraint discord_integrations.discord_integrations_channel_id_fkey FOREIGN KEY (channel_id) REFERENCES channels(id) ON DELETE CASCADE
constraint discord_integrations.discord_integrations_created_by_fkey FOREIGN KEY (created_by) REFERENCES profiles(id)
constraint discord_integrations.discord_integrations_pkey PRIMARY KEY (channel_id)
constraint job_applications.job_applications_applicant_id_fkey FOREIGN KEY (applicant_id) REFERENCES profiles(id) ON DELETE CASCADE
constraint job_applications.job_applications_job_id_applicant_id_key UNIQUE (job_id, applicant_id)
constraint job_applications.job_applications_job_id_fkey FOREIGN KEY (job_id) REFERENCES jobs(id) ON DELETE CASCADE
constraint job_applications.job_applications_pkey PRIMARY KEY (id)
constraint job_applications.job_applications_status_check CHECK ((status = ANY (ARRAY['pending'::text, 'accepted'::text, 'rejected'::text])))
constraint jobs.jobs_budget_item_id_fkey FOREIGN KEY (budget_item_id) REFERENCES budget_items(id) ON DELETE SET NULL
constraint jobs.jobs_created_by_fkey FOREIGN KEY (created_by) REFERENCES profiles(id)
constraint jobs.jobs_pkey PRIMARY KEY (id)
constraint jobs.jobs_project_id_fkey FOREIGN KEY (project_id) REFERENCES projects(id) ON DELETE CASCADE
constraint jobs.jobs_rate_type_check CHECK ((rate_type = ANY (ARRAY['hourly'::text, 'fixed'::text])))
constraint jobs.jobs_status_check CHECK ((status = ANY (ARRAY['open'::text, 'in-progress'::text, 'closed'::text])))
constraint media.media_board_check CHECK ((char_length(board) <= 60))
constraint media.media_created_by_fkey FOREIGN KEY (created_by) REFERENCES profiles(id) ON DELETE SET NULL
constraint media.media_external_url_check CHECK (((external_url IS NULL) OR ((external_url ~* '^https?://'::text) AND (char_length(external_url) <= 2000))))
constraint media.media_id_project_key UNIQUE (id, project_id)
constraint media.media_kind_check CHECK ((kind = ANY (ARRAY['image'::text, 'video'::text, 'audio'::text, 'document'::text, 'link'::text])))
constraint media.media_notes_check CHECK ((char_length(notes) <= 5000))
constraint media.media_one_source CHECK (((storage_path IS NULL) <> (external_url IS NULL)))
constraint media.media_pkey PRIMARY KEY (id)
constraint media.media_project_id_fkey FOREIGN KEY (project_id) REFERENCES projects(id) ON DELETE CASCADE
constraint media.media_size_check CHECK (((size_bytes IS NULL) OR (size_bytes >= 0)))
constraint media.media_storage_path_check CHECK (((storage_path IS NULL) OR ((storage_path ~ '^[0-9a-f-]{36}/[0-9a-f-]{36}/[^/]{1,200}$'::text) AND (split_part(storage_path, '/'::text, 1) = (project_id)::text) AND (split_part(storage_path, '/'::text, 2) = (id)::text))))
constraint media.media_storage_path_key UNIQUE (storage_path)
constraint media.media_title_check CHECK ((char_length(title) <= 200))
constraint messages.messages_channel_uuid_fkey FOREIGN KEY (channel_uuid) REFERENCES channels(id) ON DELETE CASCADE
constraint messages.messages_parent_message_id_fkey FOREIGN KEY (parent_message_id) REFERENCES messages(id) ON DELETE CASCADE
constraint messages.messages_pkey PRIMARY KEY (id)
constraint messages.messages_receiver_id_fkey FOREIGN KEY (receiver_id) REFERENCES profiles(id) ON DELETE CASCADE
constraint messages.messages_sender_id_fkey FOREIGN KEY (sender_id) REFERENCES profiles(id) ON DELETE CASCADE
constraint notifications.notifications_body_len CHECK ((char_length(body) <= 1000))
constraint notifications.notifications_created_by_fkey FOREIGN KEY (created_by) REFERENCES profiles(id) ON DELETE SET NULL
constraint notifications.notifications_link_internal CHECK (((link IS NULL) OR (link ~ '^/[^/\\]'::text)))
constraint notifications.notifications_pkey PRIMARY KEY (id)
constraint notifications.notifications_title_len CHECK (((char_length(title) >= 1) AND (char_length(title) <= 200)))
constraint notifications.notifications_type_len CHECK ((char_length(type) <= 40))
constraint notifications.notifications_user_id_fkey FOREIGN KEY (user_id) REFERENCES profiles(id) ON DELETE CASCADE
constraint portfolio_blocks.portfolio_blocks_block_type_check CHECK ((block_type = ANY (ARRAY['cover'::text, 'concept'::text, 'scene'::text, 'budget'::text, 'crew'::text, 'script'::text, 'text'::text, 'media'::text])))
constraint portfolio_blocks.portfolio_blocks_pkey PRIMARY KEY (id)
constraint portfolio_blocks.portfolio_blocks_portfolio_project_id_fkey FOREIGN KEY (portfolio_project_id) REFERENCES portfolio_projects(id) ON DELETE CASCADE
constraint portfolio_media.portfolio_media_media_type_check CHECK ((media_type = ANY (ARRAY['youtube'::text, 'gdrive'::text, 'image'::text])))
constraint portfolio_media.portfolio_media_pkey PRIMARY KEY (id)
constraint portfolio_media.portfolio_media_project_id_fkey FOREIGN KEY (project_id) REFERENCES portfolio_projects(id) ON DELETE CASCADE
constraint portfolio_projects.portfolio_projects_pkey PRIMARY KEY (id)
constraint portfolio_projects.portfolio_projects_share_token_key UNIQUE (share_token)
constraint portfolio_projects.portfolio_projects_source_project_id_fkey FOREIGN KEY (source_project_id) REFERENCES projects(id) ON DELETE SET NULL
constraint portfolio_projects.portfolio_projects_user_id_fkey FOREIGN KEY (user_id) REFERENCES profiles(id) ON DELETE CASCADE
constraint profiles.profiles_id_fkey FOREIGN KEY (id) REFERENCES auth.users(id) ON DELETE CASCADE
constraint profiles.profiles_pkey PRIMARY KEY (id)
constraint profiles.profiles_status_check CHECK ((status = ANY (ARRAY['OPEN'::text, 'BUSY'::text])))
constraint profiles.profiles_username_key UNIQUE (username)
constraint project_audio_references.project_audio_references_added_by_fkey FOREIGN KEY (added_by) REFERENCES auth.users(id)
constraint project_audio_references.project_audio_references_pkey PRIMARY KEY (id)
constraint project_audio_references.project_audio_references_project_id_fkey FOREIGN KEY (project_id) REFERENCES projects(id) ON DELETE CASCADE
constraint project_audio_references.project_audio_references_reference_type_check CHECK ((reference_type = ANY (ARRAY['spotify'::text, 'youtube'::text, 'custom_upload'::text])))
constraint project_audio_references.project_audio_references_script_id_fkey FOREIGN KEY (script_id) REFERENCES scripts(id) ON DELETE SET NULL
constraint project_beats.project_beats_created_by_fkey FOREIGN KEY (created_by) REFERENCES profiles(id)
constraint project_beats.project_beats_pkey PRIMARY KEY (id)
constraint project_beats.project_beats_project_id_fkey FOREIGN KEY (project_id) REFERENCES projects(id) ON DELETE CASCADE
constraint project_beats.project_beats_script_id_fkey FOREIGN KEY (script_id) REFERENCES scripts(id) ON DELETE SET NULL
constraint project_crew.project_crew_invited_by_fkey FOREIGN KEY (invited_by) REFERENCES profiles(id)
constraint project_crew.project_crew_pkey PRIMARY KEY (id)
constraint project_crew.project_crew_project_id_fkey FOREIGN KEY (project_id) REFERENCES projects(id) ON DELETE CASCADE
constraint project_crew.project_crew_project_id_user_id_key UNIQUE (project_id, user_id)
constraint project_crew.project_crew_status_check CHECK ((status = ANY (ARRAY['pending'::text, 'confirmed'::text, 'declined'::text])))
constraint project_crew.project_crew_user_id_fkey FOREIGN KEY (user_id) REFERENCES profiles(id) ON DELETE CASCADE
constraint project_tasks.project_tasks_assigned_to_fkey FOREIGN KEY (assigned_to) REFERENCES profiles(id)
constraint project_tasks.project_tasks_pkey PRIMARY KEY (id)
constraint project_tasks.project_tasks_project_id_fkey FOREIGN KEY (project_id) REFERENCES projects(id) ON DELETE CASCADE
constraint projects.projects_creator_id_fkey FOREIGN KEY (creator_id) REFERENCES profiles(id) ON DELETE CASCADE
constraint projects.projects_pkey PRIMARY KEY (id)
constraint projects.projects_share_token_key UNIQUE (share_token)
constraint projects.projects_visibility_check CHECK ((visibility = ANY (ARRAY['private'::text, 'team'::text, 'link'::text, 'public'::text])))
constraint scene_media.scene_media_created_by_fkey FOREIGN KEY (created_by) REFERENCES profiles(id) ON DELETE SET NULL
constraint scene_media.scene_media_media_fkey FOREIGN KEY (media_id, project_id) REFERENCES media(id, project_id) ON DELETE CASCADE
constraint scene_media.scene_media_note_check CHECK ((char_length(note) <= 1000))
constraint scene_media.scene_media_pkey PRIMARY KEY (scene_id, media_id)
constraint scene_media.scene_media_scene_fkey FOREIGN KEY (scene_id, project_id) REFERENCES scenes(id, project_id) ON DELETE CASCADE
constraint scenes.scenes_color_check CHECK (((color IS NULL) OR (color ~ '^#[0-9a-fA-F]{6}$'::text)))
constraint scenes.scenes_heading_check CHECK ((char_length(heading) <= 300))
constraint scenes.scenes_id_project_key UNIQUE (id, project_id)
constraint scenes.scenes_note_check CHECK ((char_length(note) <= 5000))
constraint scenes.scenes_pkey PRIMARY KEY (id)
constraint scenes.scenes_project_id_fkey FOREIGN KEY (project_id) REFERENCES projects(id) ON DELETE CASCADE
constraint scenes.scenes_script_id_fkey FOREIGN KEY (script_id) REFERENCES scripts(id) ON DELETE CASCADE
constraint scenes.scenes_time_of_day_check CHECK (((char_length(time_of_day) >= 1) AND (char_length(time_of_day) <= 40)))
constraint script_annotations.script_annotations_created_by_fkey FOREIGN KEY (created_by) REFERENCES profiles(id)
constraint script_annotations.script_annotations_pkey PRIMARY KEY (id)
constraint script_annotations.script_annotations_project_id_fkey FOREIGN KEY (project_id) REFERENCES projects(id) ON DELETE CASCADE
constraint script_annotations.script_annotations_script_id_fkey FOREIGN KEY (script_id) REFERENCES scripts(id) ON DELETE CASCADE
constraint script_annotations.script_annotations_type_check CHECK ((type = ANY (ARRAY['shot'::text, 'beat'::text, 'note'::text, 'revision'::text, 'reference'::text, 'todo'::text])))
constraint script_characters.script_characters_pkey PRIMARY KEY (id)
constraint script_characters.script_characters_script_id_fkey FOREIGN KEY (script_id) REFERENCES scripts(id) ON DELETE CASCADE
constraint script_characters.script_characters_script_id_name_key UNIQUE (script_id, name)
constraint script_characters.script_characters_updated_by_fkey FOREIGN KEY (updated_by) REFERENCES profiles(id)
constraint script_metadata.script_metadata_pkey PRIMARY KEY (script_id)
constraint script_metadata.script_metadata_script_id_fkey FOREIGN KEY (script_id) REFERENCES scripts(id) ON DELETE CASCADE
constraint script_metadata.script_metadata_updated_by_fkey FOREIGN KEY (updated_by) REFERENCES auth.users(id)
constraint script_revisions.script_revisions_created_by_fkey FOREIGN KEY (created_by) REFERENCES profiles(id)
constraint script_revisions.script_revisions_pkey PRIMARY KEY (id)
constraint script_revisions.script_revisions_script_id_fkey FOREIGN KEY (script_id) REFERENCES scripts(id) ON DELETE CASCADE
constraint scripts.scripts_created_by_fkey FOREIGN KEY (created_by) REFERENCES profiles(id)
constraint scripts.scripts_format_check CHECK ((format = ANY (ARRAY['screenplay'::text, 'teleplay'::text, 'stage-play'::text, 'treatment'::text, 'podcast'::text, 'doc-outline'::text])))
constraint scripts.scripts_last_edited_by_fkey FOREIGN KEY (last_edited_by) REFERENCES profiles(id)
constraint scripts.scripts_pkey PRIMARY KEY (id)
constraint scripts.scripts_project_id_fkey FOREIGN KEY (project_id) REFERENCES projects(id) ON DELETE CASCADE
constraint scripts.scripts_share_token_key UNIQUE (share_token)
constraint sfx_assets.sfx_assets_pkey PRIMARY KEY (id)
constraint sfx_assets.sfx_assets_project_id_fkey FOREIGN KEY (project_id) REFERENCES projects(id) ON DELETE CASCADE
constraint sfx_assets.sfx_assets_user_id_fkey FOREIGN KEY (user_id) REFERENCES profiles(id) ON DELETE CASCADE
constraint shots.shots_created_by_fkey FOREIGN KEY (created_by) REFERENCES profiles(id)
constraint shots.shots_pkey PRIMARY KEY (id)
constraint shots.shots_project_id_fkey FOREIGN KEY (project_id) REFERENCES projects(id) ON DELETE CASCADE
constraint shots.shots_scene_id_fkey FOREIGN KEY (scene_id) REFERENCES scenes(id) ON DELETE CASCADE
constraint shots.shots_status_check CHECK ((status = ANY (ARRAY['planned'::text, 'shot'::text, 'omitted'::text])))
constraint spotify_connections.spotify_connections_pkey PRIMARY KEY (user_id)
constraint spotify_connections.spotify_connections_user_id_fkey FOREIGN KEY (user_id) REFERENCES auth.users(id) ON DELETE CASCADE
constraint studio_assets.studio_assets_board_id_fkey FOREIGN KEY (board_id) REFERENCES studio_boards(id) ON DELETE CASCADE
constraint studio_assets.studio_assets_pkey PRIMARY KEY (id)
constraint studio_assets.studio_assets_user_id_fkey FOREIGN KEY (user_id) REFERENCES profiles(id) ON DELETE CASCADE
constraint studio_boards.studio_boards_pkey PRIMARY KEY (id)
constraint studio_boards.studio_boards_project_id_fkey FOREIGN KEY (project_id) REFERENCES projects(id) ON DELETE CASCADE
constraint studio_boards.studio_boards_user_id_fkey FOREIGN KEY (user_id) REFERENCES profiles(id) ON DELETE CASCADE
constraint timeline_items.timeline_items_assigned_to_fkey FOREIGN KEY (assigned_to) REFERENCES profiles(id)
constraint timeline_items.timeline_items_created_by_fkey FOREIGN KEY (created_by) REFERENCES profiles(id)
constraint timeline_items.timeline_items_pkey PRIMARY KEY (id)
constraint timeline_items.timeline_items_project_id_fkey FOREIGN KEY (project_id) REFERENCES projects(id) ON DELETE CASCADE
constraint timeline_items.timeline_items_status_check CHECK ((status = ANY (ARRAY['pending'::text, 'in-progress'::text, 'completed'::text, 'cancelled'::text])))
constraint timeline_items.timeline_items_type_check CHECK ((type = ANY (ARRAY['milestone'::text, 'task'::text, 'event'::text, 'deadline'::text])))
