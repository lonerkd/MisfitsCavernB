# The Cavern — environment. Copy to .env.local. Only the Supabase ones are required.

# -- Supabase (Project Settings > API) ----------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-side only — NEVER prefix with NEXT_PUBLIC_. Used by app/api/discord/notify
# to read discord_integrations.webhook_url (no client-readable RLS policy, by design).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -- Application --------------------------------------------------------------
# Your public https origin.
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# -- Optional: Spotify (https://developer.spotify.com/dashboard) --------------
# Register <origin>/auth/spotify-callback as a redirect URI. Spotify refuses
# "localhost": locally, open the app at http://127.0.0.1:3000.
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=your-spotify-client-id

# -- Optional: Discord (https://discord.com/developers) -----------------------
NEXT_PUBLIC_DISCORD_CLIENT_ID=your-discord-client-id
# The community server's public invite: shows "Join the Discord" on the landing page.
NEXT_PUBLIC_DISCORD_INVITE_URL=https://discord.gg/your-invite
# Never put a bot token or a webhook URL here or in the repo: a channel's webhook
# is entered in the Lounge (Manage channel) and stored server-side only.

# -- Optional: Web Push (adr/0004-push-dispatch-from-the-database.md) --------
# Generate keys with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://your-app.vercel.app
# Shared secret the database sends when it asks the app to push.
PUSH_DISPATCH_SECRET=
