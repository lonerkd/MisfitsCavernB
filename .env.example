# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-role key — server-side only, NEVER prefix with NEXT_PUBLIC_. Used by
# app/api/discord/notify to read discord_integrations.webhook_url, a table
# with no client-readable RLS policy by design.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Application
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Spotify (https://developer.spotify.com/dashboard)
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=your-spotify-client-id

# Discord (https://discord.com/developers)
NEXT_PUBLIC_DISCORD_CLIENT_ID=your-discord-client-id

# ── Dev / Testing (never set these in production) ──────────────────────────────
# Set NEXT_PUBLIC_DEV_MODE=true to show the dev panel on /auth.
# NEXT_PUBLIC_DEV_MODE=true

# Quick-login persona credentials (Supabase accounts you created for testing).
# NEXT_PUBLIC_DEV_SAM_EMAIL=sam@example.com
# NEXT_PUBLIC_DEV_SAM_PASS=sampassword
# NEXT_PUBLIC_DEV_JORDAN_EMAIL=jordan@example.com
# NEXT_PUBLIC_DEV_JORDAN_PASS=jordanpassword
# NEXT_PUBLIC_DEV_RILEY_EMAIL=riley@example.com
# NEXT_PUBLIC_DEV_RILEY_PASS=rileypassword

# Middleware bypass — a secret cookie-based gate that lets you visit protected
# pages without signing in (pages render in guest state).
# Set BYPASS_AUTH_SECRET to any strong random string; then visit:
#   /api/dev/bypass?secret=<value>   to activate (redirects to /projects)
#   /api/dev/bypass?clear=1          to deactivate
# BYPASS_AUTH_SECRET=change-me-to-something-random
# The hint below makes the ENABLE button in the dev panel work automatically.
# Only set it in .env.local — it is NEXT_PUBLIC so it can pre-fill the URL.
# NEXT_PUBLIC_DEV_BYPASS_HINT=change-me-to-something-random
