# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-role key — server-side only, NEVER prefix with NEXT_PUBLIC_. Used by
# app/api/discord/notify to read discord_integrations.webhook_url, a table
# with no client-readable RLS policy by design.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Application
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Spotify (https://developer.spotify.com/dashboard)
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=your-spotify-client-id

# Discord (https://discord.com/developers)
NEXT_PUBLIC_DISCORD_CLIENT_ID=your-discord-client-id
