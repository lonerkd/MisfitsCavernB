{
  "servers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.75",
        "--config",
        "C:\\Users\\kings\\.perch\\playwright-mcp-browser.json"
      ]
    },
    "courtlistener": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@iflow-mcp/blakeox-courtlistener-mcp"
      ],
      "env": {
        "COURTLISTENER_API_KEY": "REPLACE_WITH_YOUR_OWN_COURTLISTENER_TOKEN",
        "COURTLISTENER_TOKEN": "REPLACE_WITH_YOUR_OWN_COURTLISTENER_TOKEN"
      }
    }
  }
}
