{
  "name": "misfits-cavern",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "postinstall": "node scripts/copy-pdf-worker.js",
    "sync-intel": "node scripts/sync-intel.js",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "db:start": "supabase start -x studio,imgproxy,edge-runtime,logflare,vector,mailpit,supavisor,postgres-meta",
    "db:reset": "supabase db reset --local",
    "db:drift": "node scripts/db-drift.mjs",
    "demo:sql": "jiti scripts/demo/build.ts",
    "db:types": "supabase gen types typescript --local --schema public | prettier --parser typescript > lib/supabase/database.types.ts",
    "db:types:check": "npm run db:types && git diff --exit-code -- lib/supabase/database.types.ts",
    "budget": "node scripts/bundle-budget.mjs",
    "stack:up": "bash scripts/dev-stack.sh",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.105.0",
    "@tsparticles/engine": "^3.9.1",
    "@tsparticles/react": "^3.0.0",
    "@tsparticles/slim": "^3.9.1",
    "@types/diff": "^7.0.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "diff": "^9.0.0",
    "fast-average-color": "^9.5.2",
    "framer-motion": "^13.4.4",
    "idb-keyval": "^6.3.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.562.0",
    "next": "^15.5.20",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^20",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.0",
    "axe-core": "^4.11.3",
    "eslint": "^8",
    "eslint-config-next": "^15.5.20",
    "pg": "^8.20.0",
    "postcss": "^8.5.10",
    "prettier": "3.9.9",
    "supabase": "2.118.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
