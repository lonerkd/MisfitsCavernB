{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enableAllProjectMcpServers": true,
  "env": {
    "NEXT_TELEMETRY_DISABLED": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-bootstrap.sh\"",
            "timeout": 15,
            "statusMessage": "Loading Cavern context"
          }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Write",
      "WebFetch",
      "WebSearch",

      "Bash(npm run *)",
      "Bash(npm ci)",
      "Bash(npm install*)",
      "Bash(npm i)",
      "Bash(npm ls*)",
      "Bash(npm audit*)",
      "Bash(npx tsc*)",
      "Bash(npx next *)",
      "Bash(npx playwright *)",
      "Bash(npx vitest*)",
      "Bash(npx eslint*)",
      "Bash(node scripts/*)",
      "Bash(node -e*)",

      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git restore*)",
      "Bash(git stash*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git rev-parse*)",
      "Bash(git remote*)",
      "Bash(git config --get*)",
      "Bash(git push -u origin claude/*)",
      "Bash(git push origin claude/*)",
      "Bash(git push --force-with-lease origin claude/*)",

      "Bash(ls*)",
      "Bash(cat*)",
      "Bash(head*)",
      "Bash(tail*)",
      "Bash(wc*)",
      "Bash(rg*)",
      "Bash(find*)",
      "Bash(echo*)",
      "Bash(printf*)",
      "Bash(pwd)",
      "Bash(which*)",
      "Bash(command -v*)",
      "Bash(mkdir*)",
      "Bash(cp*)",
      "Bash(mv*)",
      "Bash(chmod*)",
      "Bash(sort*)",
      "Bash(uniq*)",
      "Bash(diff*)",
      "Bash(jq*)",
      "Bash(true)",

      "mcp__Supabase__list_projects",
      "mcp__Supabase__list_organizations",
      "mcp__Supabase__list_tables",
      "mcp__Supabase__list_extensions",
      "mcp__Supabase__list_migrations",
      "mcp__Supabase__list_branches",
      "mcp__Supabase__list_edge_functions",
      "mcp__Supabase__get_project",
      "mcp__Supabase__get_organization",
      "mcp__Supabase__get_project_url",
      "mcp__Supabase__get_publishable_keys",
      "mcp__Supabase__get_cost",
      "mcp__Supabase__get_advisors",
      "mcp__Supabase__get_logs",
      "mcp__Supabase__get_edge_function",
      "mcp__Supabase__generate_typescript_types",
      "mcp__Supabase__search_docs",
      "mcp__Supabase__execute_sql",

      "mcp__Vercel__list_projects",
      "mcp__Vercel__list_deployments",
      "mcp__Vercel__list_teams",
      "mcp__Vercel__get_project",
      "mcp__Vercel__get_deployment",
      "mcp__Vercel__get_deployment_build_logs",
      "mcp__Vercel__get_runtime_logs",
      "mcp__Vercel__get_runtime_errors",
      "mcp__Vercel__list_agent_runs",
      "mcp__Vercel__get_agent_run",
      "mcp__Vercel__get_agent_run_trace",
      "mcp__Vercel__list_agent_run_projects",
      "mcp__Vercel__search_vercel_documentation",
      "mcp__Vercel__web_fetch_vercel_url",
      "mcp__Vercel__get_access_to_vercel_url",

      "mcp__github__get_me",
      "mcp__github__get_file_contents",
      "mcp__github__get_commit",
      "mcp__github__list_commits",
      "mcp__github__list_branches",
      "mcp__github__list_tags",
      "mcp__github__get_tag",
      "mcp__github__list_pull_requests",
      "mcp__github__pull_request_read",
      "mcp__github__list_issues",
      "mcp__github__issue_read",
      "mcp__github__list_issue_types",
      "mcp__github__search_code",
      "mcp__github__search_issues",
      "mcp__github__search_pull_requests",
      "mcp__github__search_repositories",
      "mcp__github__search_commits",
      "mcp__github__get_check_run",
      "mcp__github__get_job_logs",
      "mcp__github__actions_get",
      "mcp__github__actions_list",
      "mcp__github__list_releases",
      "mcp__github__get_latest_release",
      "mcp__github__list_repository_collaborators",
      "mcp__github__create_pull_request",
      "mcp__github__update_pull_request",
      "mcp__github__create_branch",
      "mcp__github__push_files",
      "mcp__github__create_or_update_file",
      "mcp__github__add_issue_comment",
      "mcp__github__add_comment_to_pending_review",
      "mcp__github__add_reply_to_pull_request_comment",
      "mcp__github__pull_request_review_write",
      "mcp__github__resolve_review_thread",
      "mcp__github__unresolve_review_thread",
      "mcp__github__request_copilot_review",
      "mcp__github__subscribe_pr_activity",
      "mcp__github__unsubscribe_pr_activity",

      "mcp__Google_Drive__search_files",
      "mcp__Google_Drive__read_file_content",
      "mcp__Google_Drive__download_file_content",
      "mcp__Google_Drive__get_file_metadata",
      "mcp__Google_Drive__get_file_permissions",
      "mcp__Google_Drive__list_recent_files",

      "mcp__Indeed__search_jobs",
      "mcp__Indeed__get_job_details",
      "mcp__Indeed__get_company_data",
      "mcp__Indeed__get_resume"
    ],
    "ask": [
      "Bash(git push*)",
      "mcp__Supabase__apply_migration",
      "mcp__Supabase__create_project",
      "mcp__Supabase__pause_project",
      "mcp__Supabase__restore_project",
      "mcp__Supabase__create_branch",
      "mcp__Supabase__delete_branch",
      "mcp__Supabase__merge_branch",
      "mcp__Supabase__reset_branch",
      "mcp__Supabase__rebase_branch",
      "mcp__Supabase__deploy_edge_function",
      "mcp__Vercel__deploy_to_vercel",
      "mcp__github__merge_pull_request",
      "mcp__github__enable_pr_auto_merge",
      "mcp__github__delete_file",
      "mcp__github__create_repository",
      "mcp__github__fork_repository",
      "mcp__Google_Drive__create_file",
      "mcp__Google_Drive__copy_file"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Bash(git push --force origin main*)",
      "Bash(git push origin main*)",
      "Bash(git push -u origin main*)",
      "Bash(git push --force-with-lease origin main*)",
      "Bash(sudo *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)"
    ]
  }
}
